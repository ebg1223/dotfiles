{
  "env": {
    "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1"
  },
  "permissions": {
    "defaultMode": "dontAsk"
  },
  "model": "opus[1m]",
  "modelPicker": {
    "options": [
      {
        "model": "deepseek-v41-flash",
        "label": "DeepSeek V4.1 Flash"
      },
      {
        "model": "glm-53",
        "label": "GLM 5.3"
      }
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.agents/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "fast-jev-compaction@fast-jev-compaction": false,
    "t3-pstack@t3-pstack": false
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "fast-jev-compaction": {
      "source": {
        "source": "github",
        "repo": "tamaratran/fast-jev-compaction"
      }
    },
    "t3-pstack": {
      "source": {
        "source": "github",
        "repo": "chhoumann/t3-pstack"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "light",
  "verbose": false,
  "switchModelsOnFlag": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": false
}
